# Copie para ".env" e preencha. NUNCA versione o .env nem coloque a chave no front-end.

# Chave gerada em https://palm.tencent.com/developer/api-keys (começa com ak_; é exibida uma única vez)
PALM_API_KEY=

# AppId da aplicação criada no Developer Center (opcional neste protótipo; obrigatório para reconhecimento 1:N)
PALM_APP_ID=

# Endereço da API (internacional)
PALM_BASE_URL=https://open.intl.palm.tencent.com

# Validade do token entregue ao navegador, em segundos (padrão da API: 1800; máximo: 86400)
TOKEN_TTL_SECONDS=600
